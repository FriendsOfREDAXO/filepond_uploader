filepond_settings_ai_result_cache_enabled_notice = Speichert generierte Alt-Texte für identische Bilder und Einstellungen, um wiederholte AI-Requests zu vermeiden.
filepond_settings_ai_result_cache_ttl_hours = Cache-Gültigkeit (Stunden)
